# 复制为制作项目目录中的 .env，并把文件权限设为 600。
# macOS 默认推荐保存到钥匙串服务 shuzirenskil-91topgo-video。
# 服务器、CI 或临时测试才在权限为 600 的本地 .env 中填写。
SHUZIRENSKIL_91TOPGO_API_KEY=
# 仅在显式选择 MikuAPI 时填写；不要与 91topgo 密钥混用。
SHUZIRENSKIL_MIKUAPI_API_KEY=

# 仅在明确选择第三方 gpt-image-2 生图时填写；Codex 内置生图和自备图片无需这两项。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-image-provider.example/v1
